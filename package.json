{
  "name": "dji-media-manager",
  "productName": "DJI 素材管理器",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "浏览并安全删除 DJI 存储卡素材的桌面工具",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "JackHe",
    "email": "",
    "url": "https://github.com/jackhe"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.js",
    "bundle:ffmpeg": "node scripts/bundle-ffmpeg.js",
    "predist:mac": "npm run bundle:ffmpeg",
    "predist:win": "npm run bundle:ffmpeg-win",
    "predist": "npm run bundle:ffmpeg",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist": "electron-builder --mac dmg zip --win nsis portable",
    "dist:mac-arm64": "electron-builder --mac dmg zip --arm64",
    "dist:mac-x64": "electron-builder --mac dmg zip --x64",
    "bundle:ffmpeg-win": "node scripts/fetch-win-ffmpeg.js",
    "cross:win": "FFMPEG_BINARIES_URL=https://npmmirror.com/mirrors/ffmpeg-static/ FFMPEG_NO_PROXY=1 npm run dist:win"
  },
  "build": {
    "appId": "app.jackhe.dji-media-manager",
    "productName": "DJI 素材管理器",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "desktop/image.js",
      "public/**/*",
      "desktop/main.js",
      "desktop/server-entry.cjs",
      "package.json",
      "NOTICE.md",
      "public/reward.html"
    ],
    "extraResources": [],
    "copyright": "Copyright © 2026 JackHe · WeChat: JackHe6",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "resources/ffmpeg/ffmpeg",
          "to": "ffmpeg/ffmpeg"
        },
        {
          "from": "resources/branding/",
          "to": "branding/"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "resources/ffmpeg/ffmpeg.exe",
          "to": "ffmpeg/ffmpeg.exe"
        },
        {
          "from": "resources/ffmpeg/ffmpeg-win.LICENSE",
          "to": "ffmpeg/ffmpeg-win.LICENSE"
        },
        {
          "from": "resources/ffmpeg/ffmpeg-static-LICENSE",
          "to": "ffmpeg/ffmpeg-static-LICENSE"
        },
        {
          "from": "resources/branding/",
          "to": "branding/"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DJI 素材管理器",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "ffmpeg-static": "5.2.0"
  }
}
